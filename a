        function isOnline(lastSeen) {
            if (!lastSeen) return false;
            const tehranLastSeen = toTehranTime(lastSeen);
            if (!tehranLastSeen) return false;
            const nowTehran = new Date(new Date().getTime() + (3.5 * 60 * 60 * 1000));
            const diffSeconds = (nowTehran - tehranLastSeen) / 1000;
            return diffSeconds < 120;
        }
            function toJalaali(gy, gm, gd) {
    const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let gy2 = (gm > 2) ? (gy + 1) : gy;
    let days = 355666 + (365 * gy) + Math.floor((gy + 3) / 4) - Math.floor((gy + 99) / 100) + Math.floor((gy + 399) / 400) + gd + g_d_m[gm - 1];
    let jy = -1595 + (33 * Math.floor(days / 12053));
    days %= 12053;
    jy += 4 * Math.floor(days / 1461);
    days %= 1461;
    if (days > 365) {
        jy += Math.floor((days - 1) / 365);
        days = (days - 1) % 365;
    }
    let jm = (days < 186) ? 1 + Math.floor(days / 31) : 7 + Math.floor((days - 186) / 30);
    let jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
    return { jy: jy, jm: jm, jd: jd };
}
    
function getStatusText(lastSeen) {
    const L = t();
    if (!lastSeen) return L.statusNew;
    if (isOnline(lastSeen)) return L.statusOnline;
    
    const date = toTehranTime(lastSeen) || new Date(lastSeen);
    if (isNaN(date)) return L.statusUnknown;
    
    const now = getNowTehran();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const lastSeenDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    
    const hours = date.getHours().toString().padStart(2, '0');
    const minutes = date.getMinutes().toString().padStart(2, '0');
    const timeString = hours + ':' + minutes;
    
    if (lastSeenDate.getTime() === today.getTime()) {
        return L.lastSeenToday(timeString);
    } else {
        const diffDays = Math.floor((today - lastSeenDate) / (1000 * 60 * 60 * 24));
        if (diffDays === 1) return L.lastSeenYesterday(timeString);
        
        // تبدیل به تاریخ شمسی
        const j = toJalaali(date.getFullYear(), date.getMonth() + 1, date.getDate());
        const shamsiDate = j.jy + '/' + j.jm + '/' + j.jd;
        
        return L.lastSeenDate(shamsiDate, timeString);
    }
}
        
