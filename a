        function toTehranTime(utcDateString) {
            if (!utcDateString) return null;
            const s = utcDateString.endsWith('Z') || utcDateString.includes('+') ? utcDateString : utcDateString.replace(' ', 'T') + 'Z';
            const utcDate = new Date(s);
            if (isNaN(utcDate)) return null;
            return new Date(utcDate.getTime() + (3.5 * 60 * 60 * 1000));
        }
        function getNowTehran() {
            return new Date(new Date().getTime() + (3.5 * 60 * 60 * 1000));
        }
        function getTextDirection(text) {
            text = (text || '').toString();
            const rtlMatches = text.match(/[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF]/g) || [];
            const ltrMatches = text.match(/[A-Za-z]/g) || [];
            if (rtlMatches.length === 0 && ltrMatches.length === 0) return (currentLang === 'fa' ? 'rtl' : 'ltr');
            return rtlMatches.length >= ltrMatches.length ? 'rtl' : 'ltr';
        }
        window.applyAutoDirection = function(el) {
            if (!el) return;
            const dir = getTextDirection(el.value || el.textContent || '');
            el.setAttribute('dir', dir);
            el.style.textAlign = dir === 'rtl' ? 'right' : 'left';
        }
        window.autoGrow = function(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 130) + 'px';
        }
