    }
    
    const defaultChannel = await env.DB.prepare("SELECT * FROM channels WHERE name = ?").bind("news").first();
    if (!defaultChannel) {
      await env.DB.prepare("INSERT INTO channels (name, title, description, owner) VALUES (?, ?, ?, ?)").bind("news", "📰 اخبار رسمی", "کانال رسمی اخبار و اطلاعیه‌ها", "mostafa").run();
      await env.DB.prepare("INSERT INTO channel_subscribers (channel_name, username) VALUES (?, ?)").bind("news", "mostafa").run();
