        function toJalaali(gy, gm, gd) {
    const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let gy2 = (gm > 2) ? (gy + 1) : gy;
    let days = 355666 + (365 * gy) + Math.floor((gy + 3) / 4) - Math.floor((gy + 99) / 100) + Math.floor((gy + 399) / 400) + gd + g_d_m[gm - 1];
    let jy = -1595 + (33 * Math.floor(days / 12053));
    days %= 12053;
    jy += 4 * Math.floor(days / 1461);
    days %= 1461;
    if (days > 365) {
        jy += Math.floor((days - 1) / 365);
        days = (days - 1) % 365;
    }
    let jm = (days < 186) ? 1 + Math.floor(days / 31) : 7 + Math.floor((days - 186) / 30);
    let jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
    return { jy: jy, jm: jm, jd: jd };
}
    
function timeAgo(dateString) {
    if (!dateString) return '';
    const L = t();
    const date = toTehranTime(dateString) || new Date(dateString);
    const now = getNowTehran();
    const diff = Math.floor((now - date) / 1000);
    
    if (diff < 60) return L.justNow;
    if (diff < 3600) return L.minutesAgo(Math.floor(diff / 60));
    if (diff < 86400) return L.hoursAgo(Math.floor(diff / 3600));
    if (diff < 604800) return L.daysAgo(Math.floor(diff / 86400));
    
    if (currentLang === 'fa') {
        const jalaali = toJalaali(date.getFullYear(), date.getMonth() + 1, date.getDate());
        return jalaali.jy + '/' + String(jalaali.jm).padStart(2, '0') + '/' + String(jalaali.jd).padStart(2, '0');
    }
    return date.toLocaleDateString('en-US');
}
        
