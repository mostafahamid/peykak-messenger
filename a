        function smartPoll(fn, activeMs = 2000, hiddenMs = 15000) {
            let lastRun = 0;
            return setInterval(() => {
                const now = Date.now();
                const interval = document.hidden ? hiddenMs : activeMs;
                if (now - lastRun >= interval) {
                    lastRun = now;
                    fn();
