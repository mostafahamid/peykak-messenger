        function setNotificationsEnabled(enabled) {
            localStorage.setItem('notificationEnabled', enabled ? 'true' : 'false');
            notificationPermission = !!enabled && ('Notification' in window) && Notification.permission === 'granted';
        }
        
        async function requestNotificationPermission() {
            if (!('Notification' in window)) return false;
            if (Notification.permission === 'granted') {
                setNotificationsEnabled(true);
                return true;
            }
            if (Notification.permission === 'denied') {
                setNotificationsEnabled(false);
                return false;
            }
            const permission = await Notification.requestPermission();
            const ok = permission === 'granted';
            setNotificationsEnabled(ok);
            return ok;
        }
        
        window.toggleNotifications = async function() {
            const L = t();
            const currentlyOn = isNotificationsEnabled();
            if (currentlyOn) {
                setNotificationsEnabled(false);
                showToast('🔕', currentLang === 'fa' ? 'اعلان‌ها غیرفعال شد' : 'Notifications disabled', null);
                showSettings();
                return;
            }
            try {
                const ok = await requestNotificationPermission();
                if (ok) {
                    showToast('🔔', L.notifGranted, null);
                    showSettings();
                } else {
                    alert(L.notifDenied);
                    showSettings();
                }
            } catch(e) {
                setNotificationsEnabled(false);
                alert(L.notifDenied);
                showSettings();
            }
        }
        
        window.enableNotifications = window.toggleNotifications;
        
        let toastTimeout = null;
        function sendNotification(title, body, onClick, channelName = null) {
            if (channelName && mutedChannels[channelName]) {
                return;
            }
            if (!isNotificationsEnabled()) return;
            if (document.hidden) {
                try {
                    const n = new Notification(title, { body, icon: '💬', tag: 'peykak-message', renotify: true, silent: false });
                    if (onClick) n.onclick = () => { window.focus(); onClick(); n.close(); };
                } catch(e) {}
            }
            showToast(title, body, onClick);
        }
        
        function showToast(title, body, onClick) {
            const old = document.getElementById('peykak-toast');
            if (old) old.remove();
            if (toastTimeout) clearTimeout(toastTimeout);
            const toast = document.createElement('div');
            toast.id = 'peykak-toast';
            toast.className = 'toast-notif';
            toast.innerHTML = \`<div class="toast-avatar">💬</div><div class="toast-body"><div class="toast-sender">\${escapeHtml(title)}</div><div class="toast-text">\${escapeHtml(body)}</div></div>\`;
            toast.onclick = () => { toast.remove(); if (onClick) onClick(); };
            document.body.appendChild(toast);
            requestAnimationFrame(() => { requestAnimationFrame(() => toast.classList.add('show')); });
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => { if (toast.parentNode) toast.remove(); }, 400);
            }, 4000);
        }
        
