            if (validAvatar) return '<img class="' + cls + '" src="' + avatar + '" alt="avatar" loading="lazy">';
            
            const [c1, c2] = getAvatarColor(displayName);
            const bg = 'background:linear-gradient(135deg,' + c1 + ',' + c2 + ')';
            
            if (size === 'normal') {
                const firstWord = displayName.trim().split(/\\s+/)[0];
                const firstWordChars = [...firstWord];
                const len = firstWordChars.length;
                const fontSize = len > 5 ? '10px' : len > 3 ? '11px' : '13px';
                return '<div class="' + phCls + '" style="' + bg + ';font-size:' + fontSize + ';font-weight:700;letter-spacing:0;direction:rtl;text-align:center;line-height:1.2;padding:2px;">' + firstWord + '</div>';
            }
            if (size === 'large') {
                return '<div class="' + phCls + '" style="' + bg + ';font-size:32px;">' + initial + '</div>';
