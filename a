    try { await env.DB.prepare("CREATE INDEX IF NOT EXISTS idx_group_messages_fast ON group_messages(is_deleted, id)").run(); } catch (_) {}
    try { await env.DB.prepare("CREATE INDEX IF NOT EXISTS idx_channel_messages_fast ON channel_messages(channel_name, is_deleted, id)").run(); } catch (_) {}
