    try { await env.DB.prepare("ALTER TABLE channel_messages ADD COLUMN views_count INTEGER DEFAULT 0").run(); } catch (_) {}
    
    await env.DB.prepare(`
      CREATE TABLE IF NOT EXISTS channel_message_views (
