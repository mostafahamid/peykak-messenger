        function initGlobalSwipe() {
            document.addEventListener('touchstart', function(e) {
                const t = e.changedTouches[0];
                _swipeStartX = t.clientX;
                _swipeStartY = t.clientY;
                _swipeStartTime = Date.now();
                _swipeActive = true;
            }, { passive: true });
            
            document.addEventListener('touchend', function(e) {
                if (!_swipeActive) return;
                _swipeActive = false;
                const t = e.changedTouches[0];
                const dx = t.clientX - _swipeStartX;
                const dy = t.clientY - _swipeStartY;
                const dt = Date.now() - _swipeStartTime;
                
                if (dt > 400) return;
                if (Math.abs(dy) > Math.abs(dx) * 0.8) return;
                if (Math.abs(dx) < 60) return;
                
                const isRight = dx > 0;
                const isLeft = dx < 0;
                
                handleGlobalSwipe(isRight, isLeft);
            }, { passive: true });
        }
        
        function handleGlobalSwipe(isRight, isLeft) {
          if (currentChatUser !== undefined && currentChatUser !== null && document.getElementById('messages')) {
