                }
                let imageHtml = '';
                if (msg.image_data) imageHtml = '<div class="msg-image-wrap" data-src="' + msg.image_data + '"><img class="msg-image-blur" src="' + msg.image_data + '" alt="img"><div class="msg-image-overlay" onclick="revealImage(this)"><span>👁 مشاهده</span></div></div>';
                const editedLabel = msg.is_edited ? \`<span class="edited-label">(\${L.edited})</span>\` : '';
