    try { await env.DB.prepare("CREATE INDEX IF NOT EXISTS idx_post_comments_fast ON post_comments(post_id, is_deleted, id)").run(); } catch (_) {}
    try { await env.DB.prepare("CREATE INDEX IF NOT EXISTS idx_msg_sender_receiver ON messages(sender, receiver)").run(); } catch (_) {}
